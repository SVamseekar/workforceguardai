# Normalize line endings across platforms
* text=auto

# Source files — always LF
*.py      text eol=lf
*.sh      text eol=lf
*.sql     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.html    text eol=lf
*.css     text eol=lf
*.js      text eol=lf
*.jsx     text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.toml    text eol=lf
*.csv     text eol=lf diff
*.txt     text eol=lf

# Binary / large data — Git LFS
# xlsx was already in LFS before this branch. Do not LFS parquet/gif/mp4:
# CI skips LFS smudge (quota), so those must stay regular blobs.
*.xlsx     filter=lfs diff=lfs merge=lfs -text
*.pdf      filter=lfs diff=lfs merge=lfs -text
*.webm     filter=lfs diff=lfs merge=lfs -text
