# Normalize line endings across platforms
* text=auto

# Source files — always LF
*.py      text eol=lf
*.sh      text eol=lf
*.sql     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.html    text eol=lf
*.css     text eol=lf
*.js      text eol=lf
*.jsx     text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.toml    text eol=lf
*.csv     text eol=lf diff
*.txt     text eol=lf

# Binary / large data — Git LFS (see existing tracked patterns below)
*.webm    filter=lfs diff=lfs merge=lfs -text

data/**/*.xlsx                 filter=lfs diff=lfs merge=lfs -text
projects/**/*.docx             filter=lfs diff=lfs merge=lfs -text
projects/**/*.xlsx             filter=lfs diff=lfs merge=lfs -text
projects/**/data/**/*.csv      filter=lfs diff=lfs merge=lfs -text

# Linguist overrides
analytics/target/**            linguist-generated=true
dashboard/frontend/dist/**     linguist-generated=true
dashboard/frontend/node_modules/** linguist-vendored=true
