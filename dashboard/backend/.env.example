DATABASE_URL=postgresql://localhost/workforceguard
SESSION_SECRET=generate-with-openssl-rand-hex-32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Use the Vite dev origin so OAuth state + session cookies stay on one host (proxied /api).
OAUTH_REDIRECT_BASE_URL=http://localhost:5173
# Local HTTP dev: leave unset or set SESSION_COOKIE_SECURE=0 so OAuth cookies work without HTTPS.
# SESSION_COOKIE_SECURE=0
OAUTH_AUTO_PROVISION=1
FRONTEND_URL=http://localhost:5173/app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
WORKFORCEGUARD_ROOT=../../
