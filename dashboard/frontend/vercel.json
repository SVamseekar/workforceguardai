{
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml; charset=utf-8" }]
    }
  ],
  "rewrites": [
    {
      "source": "/api/request-demo",
      "destination": "/api/request-demo"
    },
    {
      "source": "/api/:path((?!request-demo$).*)",
      "destination": "https://api.workforceguardai.souravamseekar.com/api/:path*"
    },
    {
      "source": "/mission",
      "destination": "/mission.html"
    },
    {
      "source": "/((?!api/.*|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
