# Public sandbox CTA (landing "Try the demo" + /sandbox). Default off.
# Set to true only after magic-link email is a real transactional mailer.
# VITE_ENABLE_SANDBOX_CTA=true

# Demo request email (Vercel production env vars)
# Recipient — defaults to workforceguardai@souravamseekar.com if unset
DEMO_REQUEST_TO=workforceguardai@souravamseekar.com

# Option A (recommended on Vercel): Resend — https://resend.com
RESEND_API_KEY=re_xxxxxxxx
DEMO_REQUEST_FROM=WorkforceGuard AI <hello@workforceguardai.souravamseekar.com>

# Option B: Gmail SMTP (use an App Password, not your login password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=martisoura@gmail.com
# SMTP_PASS=your-gmail-app-password
# DEMO_REQUEST_FROM=WorkforceGuard AI <martisoura@gmail.com>
