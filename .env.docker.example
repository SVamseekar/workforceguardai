# Local Docker Compose env (Dell backend).
# Copy to `.env.docker` and fill SESSION_SECRET. Never commit `.env.docker`.
#
#   copy .env.docker.example .env.docker   # Windows
#   cp .env.docker.example .env.docker     # macOS/Linux

# Required — generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-openssl-rand-hex-32

# Vite on the Mac still uses localhost; proxy handles LAN → Dell.
OAUTH_REDIRECT_BASE_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173/app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
SESSION_COOKIE_SECURE=0
OAUTH_AUTO_PROVISION=1

# Local only: allow start even if legacy data/internal still has files.
# Production must migrate instead (see deploy/migrate-legacy-data.sh).
WORKFORCEGUARD_SKIP_MIGRATION_CHECK=1

# Optional OAuth (needed for full login flows; health/API shell works without).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# DATABASE_URL is set by docker-compose.yml for the `api` service.
# Postgres password for the compose stack is wfg_local (lab only).
