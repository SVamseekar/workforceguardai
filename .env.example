# Environment templates. Copy a template, fill values locally, never commit the copy.
#
# Backend (FastAPI / auth):
#   cp dashboard/backend/.env.example dashboard/backend/.env
#
# Frontend (Vite / Vercel serverless):
#   cp dashboard/frontend/.env.example dashboard/frontend/.env.local
#
# Local Docker Compose (API + Postgres):
#   cp .env.docker.example .env.docker
#
# Production VM (never commit the filled file):
#   cp deploy/.env.production.example deploy/.env.production
#
# Required for local API: DATABASE_URL, SESSION_SECRET
# OAuth (Google / Microsoft) is optional for health/API shell; required for login.
# Generate SESSION_SECRET with: openssl rand -hex 32
