[Unit]
Description=WorkforceGuard FastAPI Backend
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=REPLACE_USER
WorkingDirectory=/home/REPLACE_USER/WorkforceGuard-AI
EnvironmentFile=/home/REPLACE_USER/WorkforceGuard-AI/deploy/.env.production
ExecStartPre=-/usr/bin/docker stop workforceguard-api
ExecStartPre=-/usr/bin/docker rm workforceguard-api
ExecStart=/usr/bin/docker run \
  --name workforceguard-api \
  -p 8080:8080 \
  -e PORT=8080 \
  -e WORKFORCEGUARD_ROOT=/app_root \
  --env-file /home/REPLACE_USER/WorkforceGuard-AI/deploy/.env.production \
  -v /home/REPLACE_USER/WorkforceGuard-AI/data:/app_root/data \
  -v /home/REPLACE_USER/WorkforceGuard-AI/analytics:/app_root/analytics \
  workforceguard-api:latest
ExecStop=/usr/bin/docker stop workforceguard-api
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
