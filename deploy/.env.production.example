# Copy this file to deploy/.env.production on the VM and fill in the real value.
# Never commit deploy/.env.production to git.
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# Database & Analytics paths inside the container
WORKFORCEGUARD_DB_PATH=/app_root/data/workforceguard_analytics.duckdb
WORKFORCEGUARD_EU_RAW_PATH=/app_root/data/eu_raw
WORKFORCEGUARD_INTERNAL_PATH=/app_root/data/internal
WORKFORCEGUARD_REFERENCE_PATH=/app_root/data/reference
WORKFORCEGUARD_PUBLIC_COMPANY_PATH=/app_root/data/public_company
