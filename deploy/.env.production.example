# Copy this file to deploy/.env.production on the VM and fill in the real value.
# Never commit deploy/.env.production to git.
CORS_ALLOWED_ORIGINS=https://workforceguardai.souravamseekar.com

# Database & Analytics paths inside the container
WORKFORCEGUARD_DB_PATH=/app_root/data/workforceguard_analytics.duckdb
WORKFORCEGUARD_EU_RAW_PATH=/app_root/data/eu_raw
WORKFORCEGUARD_INTERNAL_PATH=/app_root/data/internal
WORKFORCEGUARD_REFERENCE_PATH=/app_root/data/reference
WORKFORCEGUARD_PUBLIC_COMPANY_PATH=/app_root/data/public_company

DATABASE_URL=postgresql://user:password@host:5432/workforceguard
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=https://api.workforceguardai.souravamseekar.com
FRONTEND_URL=https://workforceguardai.souravamseekar.com/app

# The app refuses to start if it finds data at the pre-multi-tenant legacy
# paths (data/internal, data/governance_events.sqlite,
# data/automation_schedules.json) — that data must be moved into a tenant
# first by running:
#   python migrate_to_tenant.py <admin_email> <admin_display_name> <tenant_name>
# Only set this to "1" to bypass that check (e.g. for a throwaway/local
# environment that intentionally has no real legacy data); never set it on
# a production deploy that has actual pre-migration data still in place.
WORKFORCEGUARD_SKIP_MIGRATION_CHECK=
